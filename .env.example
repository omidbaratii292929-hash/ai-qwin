# ============================================================
# OMID Industrial AI Agent — نمونه پیکربندی محیطی
# © هوشمندسازی صنعت امید — ما می‌سازیم تا شما راحت زندگی کنید
# طراح و سازندهٔ اصلی: مهندس امید براتی
# ------------------------------------------------------------
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.
# هرگز توکن یا رمز واقعی را در مخزن commit نکنید.
# ============================================================

# حالت عملیاتی پیش‌فرض: observe | simulate | control
# پیش‌فرض امن = simulate (هیچ فرمان فیزیکی صادر نمی‌شود)
OMID_MODE=simulate

# قفل سخت‌افزاری کنترل فیزیکی — فقط روی ماشین مجاز و با آزمون ایمنی روی 1 قرار گیرد
OMID_ALLOW_PHYSICAL_CONTROL=0

# مسیر ذخیره داده‌های runtime (لاگ حسابرسی، حافظه، رجیستری دستگاه‌ها، نمایه دانش)
OMID_DATA_DIR=./data

# --- هوش مصنوعی محلی (Ollama) ---
OMID_OLLAMA_URL=http://127.0.0.1:11434
OMID_OLLAMA_MODEL=
OMID_OLLAMA_TIMEOUT=30

# --- API و داشبورد ---
OMID_API_HOST=127.0.0.1
OMID_API_PORT=8000
# توکن دسترسی خواندن (خودتان یک مقدار تصادفی قوی بگذارید)
OMID_API_TOKEN=
# توکن دسترسی کنترل (برای عملیات کنترلی/فیزیکی؛ اگر خالی باشد کنترل غیرفعال می‌ماند)
OMID_CONTROL_TOKEN=
# فهرست origins مجاز CORS — پیش‌فرض خالی = فقط same-origin
OMID_CORS_ORIGINS=
OMID_RATE_LIMIT_PER_MIN=240
OMID_LANG=fa

# --- کشف شبکه (مجاز و محدود) ---
# فهرست میزبان‌های مجاز برای probe — پیش‌فرض خالی = اسکن انجام نمی‌شود
OMID_NETWORK_ALLOWLIST=
# پورت‌های صنعتی مجاز برای بررسی
OMID_NETWORK_PROBE_PORTS=502,4840,1883
